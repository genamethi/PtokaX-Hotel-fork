# 10 new connections per 60 seconds per address, on 411 and the NMDCS port.
# See POLICY for where those numbers come from.
#
#	nft -f nftables.nft

table inet ptokax {
	set flooders_v4 {
		type ipv4_addr
		flags dynamic, timeout
		timeout 10m
		size 65535
	}

	set flooders_v6 {
		type ipv6_addr
		flags dynamic, timeout
		timeout 10m
		size 65535
	}

	chain prerouting {
		type filter hook prerouting priority raw; policy accept;

		# synproxy answers the handshake itself, so a half-open flood never
		# reaches accept(). Both ports, since PtokaX and the terminator are
		# equally exposed to it.
		tcp dport { 411, 5411 } tcp flags syn notrack
	}

	chain input {
		type filter hook input priority filter; policy accept;

		ct state invalid drop
		ct state established,related accept

		tcp dport { 411, 5411 } ct state untracked \
			synproxy mss 1460 wscale 7 timestamp sack-perm

		# an address already over the limit stays out until its entry expires
		ip  saddr @flooders_v4 tcp dport { 411, 5411 } drop
		ip6 saddr @flooders_v6 tcp dport { 411, 5411 } drop

		tcp dport { 411, 5411 } ct state new \
			add @flooders_v4 { ip saddr limit rate over 10/minute } drop
		tcp dport { 411, 5411 } ct state new \
			add @flooders_v6 { ip6 saddr limit rate over 10/minute } drop
	}
}
