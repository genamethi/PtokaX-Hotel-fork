# Drop CAP_NET_BIND_SERVICE.
#
# Install as /etc/systemd/system/ptokax@<instance>.service.d/10-no-capabilities.conf
#
# The shipped unit grants CAP_NET_BIND_SERVICE because the default TCPPorts setting
# is "1209;411" and 411 is privileged. The capability is inherited across execve, and
# Lua scripts have os.execute -- so a script's child process holds it too.
#
# Use this drop-in once every port in the instance's TCPPorts setting is above 1023.
# The hub will fail to bind anything lower, and Start() only fails outright if no
# port binds at all, so check the journal after applying.

[Service]
AmbientCapabilities=
CapabilityBoundingSet=
